API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_here
DATABASE_URL=sqlite:///aluser.db
# Quyidagi buyruq bilan generatsiya qiling:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=your_generated_fernet_key_here
# Admin sifatida ishlaydigan Telegram foydalanuvchi ID'lari, vergul bilan ajratilgan
# (o'z ID'ingizni bilish uchun @userinfobot ga yozing)
ADMIN_IDS=123456789

# Server sekinlashsa ADMIN_IDS dagi adminlarga avtomatik ogohlantirish
HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_CONSECUTIVE_CHECKS=3
HEALTH_LOAD_THRESHOLD_PERCENT=90
HEALTH_MEMORY_THRESHOLD_PERCENT=90
HEALTH_DISK_THRESHOLD_PERCENT=90
HEALTH_EVENT_LOOP_LAG_SECONDS=10
